# ──────────────────────────────────────────────────────────────────────────────
# ACHouse — Variables de Entorno (Producción & Desarrollo)
# Copia este archivo a .env.local y completa los valores.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Obtén estas claves en: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Rutas de Auth (Clerk) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ─── Base de Datos (Neon PostgreSQL Serverless) ──────────────────────────────
# Obtén esta cadena en: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/achouse?sslmode=require

# ─── Almacenamiento de Recibos / Comprobantes (Opcional) ─────────────────────
# Vercel Blob o Google Cloud Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
