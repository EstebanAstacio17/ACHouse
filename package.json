{
  "name": "achouse",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo run db:generate --filter=@achouse/db",
    "db:migrate": "turbo run db:migrate --filter=@achouse/db",
    "db:studio": "turbo run db:studio --filter=@achouse/db"
  },
  "devDependencies": {
    "next": "15.5.25",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "vercel": "^59.23.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
